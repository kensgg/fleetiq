# ==============================================================
# FleetIQ — Variables de Entorno (Producción VPS)
# ==============================================================
#
# INSTRUCCIONES:
#  1. Copia este archivo: cp .env.production.example .env.production
#  2. Rellena TODOS los valores marcados con <CAMBIAR>
#  3. NUNCA subas .env.production a Git (ya está en .gitignore)
#  4. En el VPS, coloca este archivo en: ~/fleetiq/.env.production
#
# SEPARACIÓN DE SECRETOS:
#  - Variables NEXT_PUBLIC_* → Se hornean en el bundle de Next.js
#    en tiempo de build. Son seguras de exponer al navegador.
#  - Las demás variables → Solo disponibles en el servidor (Node.js).
#    NUNCA exponerlas al cliente.
# ==============================================================

# ──────────────────────────────────────────────────────────────
# Supabase — Variables de Build (inlined por el compilador)
# ──────────────────────────────────────────────────────────────

# URL pública de tu proyecto Supabase
# Obtener en: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<TU-PROJECT-ID>.supabase.co

# Anon/Publishable key — segura para exponer en el cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=<CAMBIAR: tu anon key de Supabase>

# ──────────────────────────────────────────────────────────────
# Supabase — Secretos de Servidor (SOLO backend, nunca al cliente)
# ──────────────────────────────────────────────────────────────

# Service Role Key — permisos de administrador, NUNCA exponer
# Obtener en: Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=<CAMBIAR: tu service_role key>

# JWKS URL para verificación de JWT (Auth)
SUPABASE_JWKS_URL=https://<TU-PROJECT-ID>.supabase.co/auth/v1/.well-known/jwks.json

# ──────────────────────────────────────────────────────────────
# Servicios externos
# ──────────────────────────────────────────────────────────────

# Geocodificación — en producción considera un servidor propio
# Ver: https://nominatim.org/release-docs/latest/api/Overview/
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=FleetIQ/1.0 (contacto@tu-dominio.com)

# Cálculo de rutas OSRM — reemplaza el servidor demo en producción
# Demo: https://router.project-osrm.org (sin garantías de SLA)
OSRM_BASE_URL=https://router.project-osrm.org

# ──────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────

# URL pública de tu aplicación (sin slash final)
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# Entorno (no modificar en producción)
NODE_ENV=production
