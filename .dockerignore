# ==============================================================
# .dockerignore — FleetIQ
# ==============================================================
# Excluye archivos del contexto de build de Docker.
# REGLA: si no es necesario para npm ci o npm run build → excluir.
# Menor contexto = builds más rápidos y capas de imagen más pequeñas.
# ==============================================================

# ── Dependencias (se instalan dentro del contenedor) ─────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build output (se genera dentro del contenedor) ───────────
.next
out
build

# ── Git ──────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Variables de entorno (se inyectan en runtime / ARGs) ─────
.env
.env.*
!.env.production.example   # <- El .example SÍ puede incluirse (no tiene secretos)

# ── SSL Certificates (NUNCA hornear en la imagen) ────────────
nginx/certs
*.pem
*.key
*.crt

# ── Editor / IDE / OS ────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode
.idea
*.swp
*.swo

# ── Documentación y configuración de herramientas ───────────
README.md
CLAUDE.md
AGENTS.md
DESIGN_SYSTEM.md
*.md

# ── TypeScript incremental build cache ───────────────────────
*.tsbuildinfo

# ── Herramientas de desarrollo / CI ──────────────────────────
.antigravity
.eslintcache
coverage
.nyc_output

# ── Scripts de despliegue / utilidades locales ───────────────
scripts

# ── Railway (innecesario en VPS) ─────────────────────────────
railway.json
